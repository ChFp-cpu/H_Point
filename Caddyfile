{$CADDY_DOMAIN} {
    encode zstd gzip
    header {
        -Server
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
        Permissions-Policy "geolocation=(self), camera=(), microphone=()"
    }
    @photo_uploads path /api/requests /api/chats/send
    request_body @photo_uploads {
        max_size 14680064
    }
    @event_uploads path /api/events
    request_body @event_uploads {
        max_size 1610000
    }
    @work_estimates path /api/commercial/estimates
    request_body @work_estimates {
        max_size 128KB
    }
    @small_requests {
        not path /api/requests /api/chats/send /api/events /api/commercial/estimates
    }
    request_body @small_requests {
        max_size 32KB
    }
    reverse_proxy app:8080 {
        # The application uses this value for auth rate limits. Replace any
        # inbound client-provided value rather than forwarding a spoofable one.
        header_up X-Forwarded-For {remote_host}
    }
}
