# Feature switches
# Games stay archived and disabled until explicitly restored; restart app and bot after changing.
GAMES_ENABLED=0
# Telegram
BOT_TOKEN=
# 1 — `python run.py` starts the website and bot together.
# 0 — starts only the website; start the bot independently with `python run_bot.py`.
RUN_TELEGRAM_BOT=1

# Application
APP_ENV=development
WEB_HOST=127.0.0.1
WEB_PORT=8080
WEB_PUBLIC_URL=http://127.0.0.1:8080
# Optional override. Leave empty to enable it automatically for an HTTPS URL.
SESSION_COOKIE_SECURE=
# Enable only when the app is reachable exclusively through a trusted reverse proxy.
TRUST_PROXY_HEADERS=

# Database
# Leave DATABASE_URL empty for local SQLite. Production Docker Compose requires PostgreSQL.
# URL-encode the password here if it contains reserved URL characters.
DATABASE_URL=
DB_PATH=hpoint.db

# PostgreSQL for Docker Compose. Use a long random password and URL-encode it in DATABASE_URL.
POSTGRES_USER=hpoint
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=hpoint

# Public bot name without @. Required for website sign-in through Telegram.
BOT_USERNAME=

# Production domain used by Caddy and WEB_PUBLIC_URL (for example app.example.com).
CADDY_DOMAIN=app.example.com

# Payments (Robokassa)
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD_1=
ROBOKASSA_PASSWORD_2=
ROBOKASSA_HASH_ALGORITHM=SHA256
ROBOKASSA_RESULT_URL=http://127.0.0.1:8080/api/payments/robokassa/result
PAYMENT_SUCCESS_URL=http://127.0.0.1:8080/payment/result?status=success
PAYMENT_FAIL_URL=http://127.0.0.1:8080/payment/result?status=fail

# Optional
LOG_LEVEL=INFO
ADMIN_TELEGRAM_IDS=
AI_REQUESTS_PER_DAY=20
AI_TOKENS_PER_DAY=20000
AUTH_ATTEMPT_LIMIT=5
AUTH_ATTEMPT_WINDOW_SECONDS=900
TELEGRAM_AUTH_TTL_SECONDS=300
TELEGRAM_LINK_TTL_SECONDS=600

# Email verification through Brevo SMTP. Generate an SMTP key in Brevo; do not use an API key.
# Authenticate gethpoint.ru in Brevo before sending from noreply@gethpoint.ru.
EMAIL_VERIFICATION_TTL_SECONDS=600
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_USERNAME=YOUR_BREVO_SMTP_LOGIN
SMTP_PASSWORD=YOUR_BREVO_SMTP_KEY
SMTP_FROM=H-Point <noreply@gethpoint.ru>
SMTP_USE_TLS=1
SMTP_USE_SSL=0
SMTP_TIMEOUT_SECONDS=10

# Optional phone confirmation through Brevo transactional SMS. Create an API
# key with SMS permission in Brevo, then set a registered sender name.
PHONE_VERIFICATION_TTL_SECONDS=600
BREVO_API_KEY=
SMS_SENDER=HPoint
